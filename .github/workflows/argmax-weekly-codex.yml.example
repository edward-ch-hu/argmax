# argmax weekly review with OpenAI Codex. Copy to .github/workflows/argmax-weekly.yml in your PRIVATE copy.
name: argmax weekly review (Codex)
on:
  schedule:
    - cron: "0 13 * * 1"   # Monday 13:00 UTC; set it to Monday morning in your account time zone
  workflow_dispatch:
permissions:
  contents: write
  issues: write
concurrency: argmax-account
jobs:
  weekly:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    # Secrets go only to the step that runs the agent, not job-wide (OpenAI's advice for workflows that run repo code).
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v6
      - run: uv sync
      - uses: openai/codex-action@v1
        env:
          GOOGLE_ADS_CLIENT_ID: ${{ secrets.GOOGLE_ADS_CLIENT_ID }}
          GOOGLE_ADS_CLIENT_SECRET: ${{ secrets.GOOGLE_ADS_CLIENT_SECRET }}
          GOOGLE_ADS_REFRESH_TOKEN: ${{ secrets.GOOGLE_ADS_REFRESH_TOKEN }}
          GOOGLE_ADS_LOGIN_CUSTOMER_ID: ${{ secrets.GOOGLE_ADS_LOGIN_CUSTOMER_ID }}   # optional: only via a manager account
          GOOGLE_ADS_USE_PROTO_PLUS: "True"
          ARGMAX_CONFIG_YAML: ${{ secrets.ARGMAX_CONFIG_YAML }}   # the guardrails lock: limits the agent cannot edit
          ARGMAX_COMMIT: workflow
          GH_TOKEN: ${{ github.token }}
        with:
          openai-api-key: ${{ secrets.OPENAI_API_KEY }}
          prompt-file: prompts/weekly-review.md
          sandbox: workspace-write
          # the scripts must reach the Google Ads API: network is off in workspace-write by default
          codex-args: '["-c", "sandbox_workspace_write.network_access=true"]'
      - name: Guardrail files untouched
        id: guard
        if: always()
        # The agent may write only log/, reports/, decisions/, .argmax/tmp/ and STRATEGY.md. Fails the run (and skips
        # the commit) when it changed the engine or the config, or left code in a data folder.
        run: |
          changed=$(git status --porcelain --ignored --untracked-files=all -- argmax.yaml scripts prompts trackers \
            AGENTS.md CLAUDE.md pyproject.toml .github | grep -v '__pycache__' || true)
          code=$(find log reports decisions -type f \( -name '*.py' -o -name '*.sh' \) 2>/dev/null || true)
          if [ -n "$changed$code" ]; then
            echo "::error::the agent changed guardrail files or left code in a data folder; nothing is committed"
            printf '%s\n' "$changed" "$code"
            exit 1
          fi
      - name: Commit runtime files
        if: ${{ !cancelled() && steps.guard.outcome == 'success' }}
        run: |
          git config user.name "argmax"
          git config user.email "argmax@users.noreply.github.com"
          git add -f log/ reports/ decisions/
          if [ -f STRATEGY.md ]; then git add -f STRATEGY.md; fi
          git diff --cached --quiet || git commit -m "Weekly review $(date -u +%F)"
          git pull --rebase && git push
